{
  "name": "perround",
  "version": "0.1.0",
  "private": true,
  "description": "Ammo price search ranked by what each round costs delivered to your door",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "db:start": "sh scripts/db.sh start",
    "db:stop": "sh scripts/db.sh stop",
    "db:migrate": "npm run migrate --workspace @perround/db",
    "crawl": "npm run crawl --workspace @perround/crawler --",
    "dev:api": "npm run dev --workspace @perround/api",
    "dev:web": "npm run dev --workspace @perround/web",
    "dev": "npm run dev:api & npm run dev:web",
    "test": "npm run test --workspace @perround/shared",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
