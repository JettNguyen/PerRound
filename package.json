{
  "name": "perround",
  "version": "0.1.0",
  "private": true,
  "description": "Ammo price search ranked by what each round costs delivered to your door",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "db:start": "sh scripts/db.sh start",
    "db:stop": "sh scripts/db.sh stop",
    "db:migrate": "npm run migrate --workspace @perround/db",
    "crawl": "npm run crawl --workspace @perround/crawler --",
    "dev": "npm run dev --workspace @perround/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "export": "npm run export --workspace @perround/crawler",
    "build": "npm run build --workspace @perround/web",
    "deploy": "sh scripts/deploy-pages.sh"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
